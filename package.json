{
  "name": "archive",
  "description": "Read, highlight, sort and cite research papers from arXiv and OpenReview. Browser extension and phone/iPad web app.",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:web": "vite build -c vite.web.config.ts",
    "dev:web": "vite -c vite.web.config.ts",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare && node scripts/copy-pdfjs.mjs",
    "e2e": "WXT_GOOGLE_CLIENT_ID=e2e-client.apps.googleusercontent.com wxt build && for t in core reader ai pages library; do node e2e/test-$t.mjs || exit 1; done && npm run e2e:web",
    "e2e:web": "npm run build:web && node e2e/test-web.mjs",
    "fixtures": "python3 e2e/make_fixtures.py"
  },
  "dependencies": {
    "approx-string-match": "^2.0.0",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.16",
    "fast-xml-parser": "^5.11.2",
    "katex": "^0.19.0",
    "marked": "^14.1.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "jsdom": "^25.0.1",
    "playwright": "^1.56.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3",
    "wxt": "^0.20.27"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Manas2006/archive.git"
  },
  "private": true
}
