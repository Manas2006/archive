# Google sign-in client for the Drive features of the official builds. It is public,
# not a secret (it's in every sign-in request), and only works for the official
# extension ids and manas2006.github.io. Forks: put your own in .env.local (it wins over
# this file); see docs/google-drive-setup.md. Without one, Drive is simply hidden.
WXT_GOOGLE_CLIENT_ID=972457886922-f3hvl6a5j30h952g6bscu67o33pdsq81.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=972457886922-f3hvl6a5j30h952g6bscu67o33pdsq81.apps.googleusercontent.com
